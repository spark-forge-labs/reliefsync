# Everything is optional – the prototype runs fully offline with deterministic agents.
ANTHROPIC_API_KEY=            # Claude structured triage (falls back to rule engine)
RELIEFSYNC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=               # Whisper transcription/translation of voice notes
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550000000      # your Twilio number; set its inbound webhook to  <PUBLIC_URL>/api/sms/twilio
DEMO_PHONE_FOR=+15555550101   # seed volunteer (Maya) ...
DEMO_PHONE_OVERRIDE=          # ... whose SMS is redirected to the on-stage phone
PUBLIC_URL=http://localhost:8000
GEOCODE_ONLINE=0              # 1 = fall back to OSM Nominatim for unknown landmarks
DISPATCH_TIMEOUT_S=180        # escalation timeout per volunteer (use 45 on stage)
VOLUNTEER_RADIUS_MI=2.0
DEMO_TRAVEL_SECONDS=45        # how long the en-route animation takes
